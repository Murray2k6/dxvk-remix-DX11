+/* Remix: tell the layer which push-constant ranges this command signature's
+ * commands set for the root signature's graphics pipeline layout, and where
+ * each sits in a command (the D3D12 argument layout, which the replay reads
+ * directly). Signatures that also change views or vertex / index buffers per
+ * command are not reported: the replay cannot reproduce those. */
+static void remix_note_command_signature(const D3D12_COMMAND_SIGNATURE_DESC *desc,
+        struct d3d12_root_signature *root_signature)
+{
+    remix_vkfe_indirect_constant constants[REMIX_VKFE_MAX_INDIRECT_CONSTANTS];
+    PFN_remix_vklayer_note_indirect_layout note = remix_note_indirect_layout_entry();
+    const struct vkd3d_shader_root_constant *root_constant;
+    uint32_t constant_count = 0, offset = 0;
+    unsigned int i;
+
+    if (!note || !root_signature || !root_signature->graphics.vk_pipeline_layout)
+        return;
+
+    for (i = 0; i < desc->NumArgumentDescs; i++)
+    {
+        const D3D12_INDIRECT_ARGUMENT_DESC *arg = &desc->pArgumentDescs[i];
+
+        switch (arg->Type)
+        {
+            case D3D12_INDIRECT_ARGUMENT_TYPE_CONSTANT:
+                if (constant_count == REMIX_VKFE_MAX_INDIRECT_CONSTANTS ||
+                        !(root_constant = root_signature_get_32bit_constants(root_signature, arg->Constant.RootParameterIndex)))
+                    return;
+                constants[constant_count].push_offset =
+                        (root_constant->constant_index + arg->Constant.DestOffsetIn32BitValues) * sizeof(uint32_t);
+                constants[constant_count].size = arg->Constant.Num32BitValuesToSet * sizeof(uint32_t);
+                constants[constant_count].command_offset = offset;
+                constant_count++;
+                offset += arg->Constant.Num32BitValuesToSet * sizeof(uint32_t);
+                break;
+
+            case D3D12_INDIRECT_ARGUMENT_TYPE_INCREMENTING_CONSTANT:
+                if (constant_count == REMIX_VKFE_MAX_INDIRECT_CONSTANTS ||
+                        !(root_constant = root_signature_get_32bit_constants(root_signature,
+                                arg->IncrementingConstant.RootParameterIndex)))
+                    return;
+                constants[constant_count].push_offset =
+                        (root_constant->constant_index + arg->IncrementingConstant.DestOffsetIn32BitValues) * sizeof(uint32_t);
+                constants[constant_count].size = sizeof(uint32_t);
+                constants[constant_count].command_offset = REMIX_VKFE_INDIRECT_COMMAND_INDEX;
+                constant_count++;
+                break;
+
+            case D3D12_INDIRECT_ARGUMENT_TYPE_DRAW:
+            case D3D12_INDIRECT_ARGUMENT_TYPE_DRAW_INDEXED:
+                break;
+
+            default:
+                return;
+        }
+    }
+
+    if (constant_count)
+        note(root_signature->graphics.vk_pipeline_layout, desc->ByteStride, constant_count, constants);
+}
