+/* Remix: an export of the Remix Vulkan layer, or NULL when it is not loaded.
+ * Resolving twice on a race is harmless: both find the same export. */
+static void *remix_layer_entry(const char *name, void **cache, uint32_t *resolved)
+{
+#ifdef _WIN32
+    if (!vkd3d_atomic_uint32_load_explicit(resolved, vkd3d_memory_order_acquire))
+    {
+        HMODULE module = GetModuleHandleA("remix_vk_layer.dll");
+        *cache = module ? (void *)GetProcAddress(module, name) : NULL;
+        vkd3d_atomic_uint32_store_explicit(resolved, 1, vkd3d_memory_order_release);
+    }
+    return *cache;
+#else
+    return NULL;
+#endif
+}
