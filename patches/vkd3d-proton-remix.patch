+static void d3d12_command_list_remix_annotate_draw(struct d3d12_command_list *list)
+{
+    /* Root CBVs and tables in a frame rarely exceed a few dozen entries. */
+    enum { REMIX_MAX_ANNOTATIONS = 128, REMIX_MAX_RANGE = 8 };
+    const struct vkd3d_pipeline_bindings *bindings = &list->graphics_bindings;
+    const struct d3d12_root_signature *rs = bindings->root_signature;
+    const struct vkd3d_descriptor_metadata_view *heap = list->cbv_srv_uav_descriptors_view;
+    remix_vkfe_binding out[REMIX_MAX_ANNOTATIONS];
+    PFN_remix_vklayer_annotate_draw annotate;
+    unsigned int count = 0, constant = 0, i, j, k;
+
+    if (!(annotate = remix_annotate_entry()) || !rs)
+        return;
+
+    for (i = 0; i < rs->parameter_count && count < REMIX_MAX_ANNOTATIONS; i++)
+    {
+        const struct vkd3d_shader_root_parameter *p = &rs->parameters[i];
+
+        switch (p->parameter_type)
+        {
+            case D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS:
+            {
+                /* root_constants[] lists the constant parameters in order. */
+                const struct vkd3d_shader_push_constant_buffer *c = &rs->root_constants[constant++];
+                remix_vkfe_binding *b = &out[count++];
+
+                memset(b, 0, sizeof(*b));
+                /* Push-constant kind: the values live in the list state at the
+                 * same address for every draw, so Remix must copy them per draw
+                 * rather than share bytes by address. Register and space still
+                 * name the b# they are bound as. */
+                b->kind = REMIX_VKFE_BINDING_PUSH_CONSTANTS;
+                b->stage_mask = remix_stage_mask(c->shader_visibility);
+                b->slot = c->register_index;
+                b->space = c->register_space;
+                b->size = c->size;
+                b->host_data = &bindings->root_constants[p->constant.constant_index];
+                break;
+            }
+
+            case D3D12_ROOT_PARAMETER_TYPE_CBV:
+            case D3D12_ROOT_PARAMETER_TYPE_SRV:
+            {
+                const struct vkd3d_shader_resource_binding *rb = p->descriptor.binding;
+                VkDeviceAddress va = bindings->remix_root_descriptor_va[i];
+                bool is_cbv = p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_CBV;
+                VkDeviceSize size = 0;
+                uint32_t per_draw = 0;
+                const void *cpu = remix_cpu_from_va(list, va, &size, &per_draw);
+                remix_vkfe_binding *b;
+
+                if (!rb || !va)
+                    break;
+
+                b = &out[count++];
+                memset(b, 0, sizeof(*b));
+                b->kind = is_cbv ? REMIX_VKFE_BINDING_CONSTANT_BUFFER : REMIX_VKFE_BINDING_STORAGE_BUFFER;
+                b->stage_mask = remix_stage_mask(rb->shader_visibility);
+                b->slot = rb->register_index;
+                b->space = rb->register_space;
+                b->address = va;
+                /* Root SRVs carry no size; the allocation's end bounds them. */
+                b->size = is_cbv ? min(size, (VkDeviceSize)D3D12_REQ_CONSTANT_BUFFER_ELEMENT_COUNT * 16u) : size;
+                b->host_data = cpu;
+                b->host_data_per_draw = per_draw;
+                break;
+            }
+
+            case D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE:
+            {
+                /* Tables are read from the shader-visible heap's CPU
+                 * metadata, which exists on the classic descriptor path the
+                 * Remix layer selects (it hides VK_EXT_descriptor_buffer). */
+                if (!heap)
+                    break;
+
+                for (j = 0; j < p->descriptor_table.binding_count && count < REMIX_MAX_ANNOTATIONS; j++)
+                {
+                    const struct vkd3d_shader_resource_binding *rb = &p->descriptor_table.first_binding[j];
+                    /* Unbounded ranges: only the first entry is known to be in the heap. */
+                    unsigned int range = rb->register_count == ~0u ? 1u : min(rb->register_count, (unsigned int)REMIX_MAX_RANGE);
+                    bool is_cbv = rb->type == VKD3D_SHADER_DESCRIPTOR_TYPE_CBV;
+                    bool is_srv_image = rb->type == VKD3D_SHADER_DESCRIPTOR_TYPE_SRV &&
+                            (rb->flags & VKD3D_SHADER_BINDING_FLAG_IMAGE);
+                    /* Structured / typed buffers: engine light lists (UE local
+                     * lights, HDRP LightData) live in these. */
+                    bool is_srv_buffer = rb->type == VKD3D_SHADER_DESCRIPTOR_TYPE_SRV &&
+                            (rb->flags & VKD3D_SHADER_BINDING_FLAG_BUFFER);
+
+                    if (!is_cbv && !is_srv_image && !is_srv_buffer)
+                        continue;
+
+                    for (k = 0; k < range && count < REMIX_MAX_ANNOTATIONS; k++)
+                    {
+                        const struct vkd3d_descriptor_metadata_view *view = heap +
+                                bindings->descriptor_tables[rb->descriptor_table] + rb->descriptor_offset + k;
+                        remix_vkfe_binding *b = &out[count];
+
+                        memset(b, 0, sizeof(*b));
+                        b->stage_mask = remix_stage_mask(rb->shader_visibility);
+                        b->slot = rb->register_index + k;
+                        b->space = rb->register_space;
+
+                        if (is_cbv || is_srv_buffer)
+                        {
+                            VkDeviceSize size = 0;
+                            uint32_t per_draw = 0;
+
+                            if (!(view->info.buffer.flags & VKD3D_DESCRIPTOR_FLAG_BUFFER_VA_RANGE))
+                                continue;
+
+                            b->kind = is_cbv ? REMIX_VKFE_BINDING_CONSTANT_BUFFER : REMIX_VKFE_BINDING_STORAGE_BUFFER;
+                            b->address = view->info.buffer.va;
+                            b->host_data = remix_cpu_from_va(list, view->info.buffer.va, &size, &per_draw);
+                            b->host_data_per_draw = per_draw;
+                            b->size = b->host_data ? min((VkDeviceSize)view->info.buffer.range, size)
+                                    : (VkDeviceSize)view->info.buffer.range;
+                            /* The Vulkan buffer behind the view, so Remix can copy
+                             * GPU-only bytes back (material tables, light lists). */
+                            remix_buffer_from_va(list, view->info.buffer.va, &b->buffer, &b->offset);
+                        }
+                        else
+                        {
+                            const struct vkd3d_view *image_view = view->info.image.view;
+
+                            if (!(view->info.image.flags & VKD3D_DESCRIPTOR_FLAG_IMAGE_VIEW) || !image_view)
+                                continue;
+
+                            b->kind = REMIX_VKFE_BINDING_TEXTURE;
+                            b->view = image_view->vk_image_view;
+                            b->layout = image_view->remix_layout;
+                        }
+
+                        count++;
+                    }
+                }
+                break;
+            }
+
+            default:
+                /* Root UAVs are written by the GPU: nothing to read. */
+                break;
+        }
+    }
+
+    /* The bound shader-visible heap, for SM 6.6 ResourceDescriptorHeap[]
+     * indices Remix finds in material data (remix_vkd3d_heap_view). */
+    if (heap && list->remix_cbv_srv_uav_count && count < REMIX_MAX_ANNOTATIONS)
+    {
+        remix_vkfe_binding *b = &out[count++];
+
+        memset(b, 0, sizeof(*b));
+        b->kind = REMIX_VKFE_BINDING_DESCRIPTOR_HEAP;
+        b->stage_mask = (1u << REMIX_VKFE_STAGE_COUNT) - 1u;
+        b->host_data = heap;
+        b->size = list->remix_cbv_srv_uav_count;
+    }
+
+    annotate(list->cmd.vk_command_buffer, out, count);
+}
