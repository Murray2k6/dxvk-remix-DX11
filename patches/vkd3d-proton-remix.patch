+/* Remix: the Remix Vulkan layer sees this list's Vulkan commands (pipelines,
+ * draws, present) but not what is lost below D3D12: root CBV addresses and
+ * descriptor heap contents. Right before each draw, report the D3D12
+ * bindings of the graphics root signature to the layer, which attaches them
+ * to the draw it is about to see. Inert when the layer is not loaded. */
+static PFN_remix_vklayer_annotate_draw remix_annotate_entry(void)
+{
+    static PFN_remix_vklayer_annotate_draw entry;
+    static uint32_t resolved;
+
+#ifdef _WIN32
+    /* Resolving twice on a race is harmless: both find the same export. */
+    if (!vkd3d_atomic_uint32_load_explicit(&resolved, vkd3d_memory_order_acquire))
+    {
+        HMODULE module = GetModuleHandleA("remix_vk_layer.dll");
+        entry = module ? (PFN_remix_vklayer_annotate_draw)(void *)GetProcAddress(module,
+                REMIX_VKLAYER_ANNOTATE_ENTRY_POINT) : NULL;
+        vkd3d_atomic_uint32_store_explicit(&resolved, 1, vkd3d_memory_order_release);
+    }
+#endif
+
+    return entry;
+}
