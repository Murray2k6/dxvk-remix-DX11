+/* Remix: live shader-visible CBV/SRV/UAV heaps (their metadata arrays), so
+ * remix_vkd3d_heap_view never reads a heap destroyed since Remix saw it.
+ * Lookups run under the same lock as destruction. */
+#define REMIX_MAX_LIVE_HEAPS 64
+static pthread_mutex_t remix_heap_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct { const void *metadata; uint32_t count; } remix_live_heaps[REMIX_MAX_LIVE_HEAPS];
+
+static bool remix_heap_is_tracked(const struct d3d12_device *device, const D3D12_DESCRIPTOR_HEAP_DESC *desc)
+{
+    return desc->Type == D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV &&
+            (desc->Flags & D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE) &&
+            !d3d12_device_use_embedded_mutable_descriptors(device);
+}
+
+static void remix_heap_register(const void *metadata, uint32_t count)
+{
+    unsigned int i;
+
+    pthread_mutex_lock(&remix_heap_lock);
+    for (i = 0; i < REMIX_MAX_LIVE_HEAPS; i++)
+    {
+        if (!remix_live_heaps[i].metadata)
+        {
+            remix_live_heaps[i].metadata = metadata;
+            remix_live_heaps[i].count = count;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&remix_heap_lock);
+}
+
+static void remix_heap_unregister(const void *metadata)
+{
+    unsigned int i;
+
+    pthread_mutex_lock(&remix_heap_lock);
+    for (i = 0; i < REMIX_MAX_LIVE_HEAPS; i++)
+    {
+        if (remix_live_heaps[i].metadata == metadata)
+            remix_live_heaps[i].metadata = NULL;
+    }
+    pthread_mutex_unlock(&remix_heap_lock);
+}
+
+/* Remix: descriptor `index` of a heap reported as
+ * REMIX_VKFE_BINDING_DESCRIPTOR_HEAP (exported from d3d12core.dll). */
+uint32_t remix_vkd3d_heap_view(const void *heap, uint32_t descriptor_count, uint32_t index,
+        VkImageView *view, VkImageLayout *layout)
+{
+    const struct vkd3d_descriptor_metadata_view *metadata = heap;
+    const struct vkd3d_view *image_view;
+    uint32_t result = 0;
+    unsigned int i;
+
+    if (!metadata || !view || !layout || index >= descriptor_count)
+        return 0;
+
+    pthread_mutex_lock(&remix_heap_lock);
+
+    for (i = 0; i < REMIX_MAX_LIVE_HEAPS; i++)
+    {
+        if (remix_live_heaps[i].metadata == heap && index < remix_live_heaps[i].count)
+        {
+            metadata += index;
+
+            if ((metadata->info.image.flags & VKD3D_DESCRIPTOR_FLAG_IMAGE_VIEW) &&
+                    (image_view = metadata->info.image.view))
+            {
+                *view = image_view->vk_image_view;
+                *layout = image_view->remix_layout;
+                result = 1;
+            }
+            break;
+        }
+    }
+
+    pthread_mutex_unlock(&remix_heap_lock);
+    return result;
+}
