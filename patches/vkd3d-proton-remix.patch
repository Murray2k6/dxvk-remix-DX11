+static uint32_t remix_stage_mask(enum vkd3d_shader_visibility visibility)
+{
+    switch (visibility)
+    {
+        case VKD3D_SHADER_VISIBILITY_VERTEX:        return 1u << REMIX_VKFE_STAGE_VERTEX;
+        case VKD3D_SHADER_VISIBILITY_HULL:          return 1u << REMIX_VKFE_STAGE_HULL;
+        case VKD3D_SHADER_VISIBILITY_DOMAIN:        return 1u << REMIX_VKFE_STAGE_DOMAIN;
+        case VKD3D_SHADER_VISIBILITY_GEOMETRY:      return 1u << REMIX_VKFE_STAGE_GEOMETRY;
+        case VKD3D_SHADER_VISIBILITY_PIXEL:         return 1u << REMIX_VKFE_STAGE_PIXEL;
+        case VKD3D_SHADER_VISIBILITY_AMPLIFICATION: return 1u << REMIX_VKFE_STAGE_TASK;
+        case VKD3D_SHADER_VISIBILITY_MESH:          return 1u << REMIX_VKFE_STAGE_MESH;
+        default:                                    return (1u << REMIX_VKFE_STAGE_COUNT) - 1u;
+    }
+}
