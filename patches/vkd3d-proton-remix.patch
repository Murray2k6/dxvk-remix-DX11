+/* CPU pointer of a GPU VA in host-visible memory (upload / ReBAR / custom
+ * write-back heaps), or in the shadow of a default-heap buffer filled by
+ * CopyBufferRegion (remix_shadow_copy), or NULL. */
+static const void *remix_cpu_from_va(struct d3d12_command_list *list, VkDeviceAddress va, VkDeviceSize *size,
+        uint32_t *per_draw)
+{
+    const struct vkd3d_unique_resource *res;
+    const struct remix_shadow *shadow;
+    VkDeviceSize offset, page;
+    const uint8_t *bytes;
+
+    *per_draw = 0;
+
+    if (!va)
+        return NULL;
+
+    res = vkd3d_va_map_deref(&list->device->memory_allocator.va_map, va);
+
+    if (!res || va < res->va || va - res->va >= res->size)
+        return NULL;
+
+    offset = va - res->va;
+
+    if (res->remix_cpu_address)
+    {
+        *size = res->size - offset;
+        return (const uint8_t *)res->remix_cpu_address + offset;
+    }
+
+    /* Within one shadow page: constant buffers are at most 64 KiB and
+     * 256-byte aligned, so a CBV rarely crosses one; when it does, the
+     * part in the page is what Remix reads. */
+    shadow = vkd3d_atomic_ptr_load_explicit(&res->remix_shadow, vkd3d_memory_order_acquire);
+    page = offset / REMIX_SHADOW_PAGE_SIZE;
+
+    if (!shadow || page >= shadow->page_count)
+        return NULL;
+
+    bytes = vkd3d_atomic_ptr_load_explicit(&shadow->pages[page], vkd3d_memory_order_acquire);
+
+    if (!bytes)
+        return NULL;
+
+    *size = min(res->size - offset, (VkDeviceSize)REMIX_SHADOW_PAGE_SIZE - offset % REMIX_SHADOW_PAGE_SIZE);
+    *per_draw = 1;
+    return bytes + offset % REMIX_SHADOW_PAGE_SIZE;
+}
+
+/* The VkBuffer and offset holding a GPU VA, or VK_NULL_HANDLE. */
+static void remix_buffer_from_va(struct d3d12_command_list *list, VkDeviceAddress va,
+        VkBuffer *buffer, VkDeviceSize *offset)
+{
+    const struct vkd3d_unique_resource *res;
+
+    *buffer = VK_NULL_HANDLE;
+    *offset = 0;
+
+    if (!va || !(res = vkd3d_va_map_deref(&list->device->memory_allocator.va_map, va)) ||
+            va < res->va || va - res->va >= res->size)
+        return;
+
+    *buffer = res->vk_buffer;
+    *offset = va - res->va;
+}
+
+/* Copy-source tracing for default-heap constant buffers: engines write
+ * constants into an upload ring and CopyBufferRegion them into a default
+ * buffer the root / table CBVs point at, which the CPU cannot read. Keep the
+ * bytes copied, as of recording, in a page shadow of the destination. Only
+ * small copies (constant-buffer sized), so geometry and texture uploads are
+ * not duplicated. Recording threads racing on the same bytes write the
+ * same kind of data; pages are published with compare-exchange. */
+static void remix_shadow_copy(struct d3d12_command_list *list, VkDeviceAddress dst_va,
+        VkDeviceAddress src_va, VkDeviceSize byte_count)
+{
+    struct vkd3d_unique_resource *dst;
+    struct remix_shadow *shadow, *existing;
+    VkDeviceSize src_size = 0, offset, page_count, done = 0;
+    uint32_t src_shadowed;
+    const uint8_t *src;
+
+    if (!remix_annotate_entry() || !byte_count || byte_count > D3D12_REQ_CONSTANT_BUFFER_ELEMENT_COUNT * 16u)
+        return;
+
+    /* Copies between default buffers chain through their shadows. */
+    if (!(src = remix_cpu_from_va(list, src_va, &src_size, &src_shadowed)) || src_size < byte_count)
+        return;
+
+    dst = (struct vkd3d_unique_resource *)vkd3d_va_map_deref(&list->device->memory_allocator.va_map, dst_va);
+
+    if (!dst || dst->remix_cpu_address || dst_va < dst->va || dst_va - dst->va + byte_count > dst->size)
+        return;
+
+    shadow = vkd3d_atomic_ptr_load_explicit(&dst->remix_shadow, vkd3d_memory_order_acquire);
+
+    if (!shadow)
+    {
+        page_count = (dst->size + REMIX_SHADOW_PAGE_SIZE - 1) / REMIX_SHADOW_PAGE_SIZE;
+
+        if (!(shadow = vkd3d_calloc(1, sizeof(*shadow) + page_count * sizeof(shadow->pages[0]))))
+            return;
+
+        shadow->page_count = page_count;
+        existing = vkd3d_atomic_ptr_compare_exchange(&dst->remix_shadow, NULL, shadow,
+                vkd3d_memory_order_release, vkd3d_memory_order_acquire);
+
+        if (existing)
+        {
+            vkd3d_free(shadow);
+            shadow = existing;
+        }
+    }
+
+    offset = dst_va - dst->va;
+
+    while (done < byte_count)
+    {
+        VkDeviceSize page = (offset + done) / REMIX_SHADOW_PAGE_SIZE;
+        VkDeviceSize in_page = (offset + done) % REMIX_SHADOW_PAGE_SIZE;
+        VkDeviceSize n = min(byte_count - done, (VkDeviceSize)REMIX_SHADOW_PAGE_SIZE - in_page);
+        uint8_t *bytes = vkd3d_atomic_ptr_load_explicit(&shadow->pages[page], vkd3d_memory_order_acquire);
+
+        if (!bytes)
+        {
+            uint8_t *fresh, *other;
+
+            if (!(fresh = vkd3d_calloc(1, REMIX_SHADOW_PAGE_SIZE)))
+                return;
+
+            other = vkd3d_atomic_ptr_compare_exchange(&shadow->pages[page], NULL, fresh,
+                    vkd3d_memory_order_release, vkd3d_memory_order_acquire);
+
+            if (other)
+            {
+                vkd3d_free(fresh);
+                bytes = other;
+            }
+            else
+                bytes = fresh;
+        }
+
+        /* memmove: a copy within one default buffer reads its own shadow. */
+        memmove(bytes + in_page, src + done, n);
+        done += n;
+    }
+}
